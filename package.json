{
  "name": "atmo-weather-globe",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test:browser": "playwright test",
    "desktop": "npm run build && electron .",
    "package:win": "node node_modules/electron/install.js && npm run build && electron-builder --win nsis --x64"
  },
  "description": "Interactive 3D Earth with live local weather and volumetric atmospheric effects",
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "type": "module",
  "private": true,
  "main": "desktop/main.cjs",
  "build": {
    "appId": "org.weathervisualizer.desktop",
    "productName": "Weather Visualizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*.mjs",
      "desktop/**/*",
      "docs/**/*",
      "package.json",
      "!**/.env*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Weather-Visualizer-${version}-${arch}-Setup.${ext}",
    "electronDist": "node_modules/electron/dist"
  }
}
